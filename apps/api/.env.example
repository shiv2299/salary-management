NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/app.db
LOG_LEVEL=info

# Signs the session cookie. Required in production (32+ characters); development has a built-in default.
# Generate one with: openssl rand -base64 48
# JWT_SECRET=

# The HR login, created on first boot only (never overwritten). Set both or neither; password 8+ characters.
# Without them the app starts but nobody can log in.
HR_SEED_EMAIL=hr@acme.example
HR_SEED_PASSWORD=change-me-before-use
