# Configuration for the Docker image / docker compose. Copy to .env and fill in; never commit .env.
# For local development without Docker use apps/api/.env.example instead.

# Signs the session cookie. Required in production, at least 32 characters; the container refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# The HR login, created on first boot only (an existing user is never overwritten). Set both or neither; password 8+ characters.
HR_SEED_EMAIL=hr@example.com
HR_SEED_PASSWORD=replace-with-a-strong-password
